<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\common-tests.props"/>

    <PropertyGroup>
        <!-- Stylecop -->
        <CodeAnalysisRuleSet>..\Analyzer-Tests.ruleset</CodeAnalysisRuleSet>

        <!-- Package -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- target frameworks based on OS -->
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <!-- Windows: test all frameworks -->
        <TargetFrameworks>net8.0;net10.0;net462;net47;net471;net472;net48;net481</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
        <!-- Linux/macOS: test only .NET Core -->
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <!-- project dependencies -->
        <ProjectReference Include="..\PPWCode.Vernacular.Contracts.I\PPWCode.Vernacular.Contracts.I.csproj"/>
    </ItemGroup>

</Project>
